# Deliberate release values; never derive a version/sequence from the clock.
CHAINCODE_NAME=agrochain
CHAINCODE_VERSION=0.2.1
# First definition on a fresh channel. Existing matching releases reuse their
# committed sequence; upgrades always require an explicit next sequence.
CHAINCODE_SEQUENCE=1
CHAINCODE_POLICY="AND('RetailerMSP.peer','RegulatorMSP.peer')"
